{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/client/dist/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/client/dist/robots.txt"
    },
    {
      "source": "/llm.txt",
      "destination": "/client/dist/llm.txt"
    },
    {
      "source": "/favicon.jpg",
      "destination": "/client/dist/favicon.jpg"
    },
    {
      "source": "/logo.jpg",
      "destination": "/client/dist/logo.jpg"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/dist/assets/$1"
    },
    {
      "source": "/((?!api/|uploads/|assets/).*)",
      "destination": "/client/dist/index.html"
    }
  ]
}
