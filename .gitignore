# ================================================================
# Git Ignore Configuration - Vista Tour & Travels (MERN Monorepo)
# ================================================================

# Dependencies
node_modules/
**/node_modules/

# Environment & Secret Files (NEVER COMMIT REAL SECRETS)
.env
.env.*
*.env
!.env.example
!.env.*.example

# Production & Development Builds
dist/
dist-ssr/
build/
**/dist/
**/build/

# Testing & Coverage
coverage/
.nyc_output/

# Logs & Debuggers
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local Runtime & Temporary Files
.cache/
.tmp/
*.tmp
*.temp
*.pid
*.seed

# Local Uploads (Preserve folder structure via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.swp
*.swo

# Serverless & Provider Cache
.vercel/
.serverless/